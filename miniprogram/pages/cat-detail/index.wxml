<view class="detail-page">
  <view class="custom-nav" style="height: {{navHeight}}px;">
    <view
      class="back-button"
      style="top: {{navContentTop}}px; height: {{menuHeight}}px;"
      bindtap="onTapBack"
    >
      <image class="back-icon" src="/static/cat-detail/icon_back_arrow.png" mode="aspectFit" />
    </view>
    <view
      class="custom-nav__title"
      style="top: {{navContentTop}}px; height: {{menuHeight}}px; line-height: {{menuHeight}}px;"
    >
      {{title}}
    </view>
  </view>

  <scroll-view class="detail-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="detail-content" style="padding-top: {{navHeight}}px;">
      <view class="state-block" wx:if="{{status === 'loading'}}">加载中</view>
      <view class="state-block" wx:elif="{{status === 'error'}}">{{errorMessage}}</view>

      <block wx:else>
        <image class="hero-image" src="{{cat.image}}" mode="aspectFill" />

        <view class="profile-card">
          <view class="profile-main">
            <view class="cat-name">{{cat.name}}</view>
            <view class="intro-tags">
              <block wx:for="{{cat.introTags}}" wx:key="*this">
                <view class="intro-tag">{{item}}</view>
              </block>
            </view>
          </view>
          <view class="adopt-pill">{{cat.adoptableText}}</view>
        </view>

        <view class="info-card">
          <block wx:for="{{cat.details}}" wx:key="key">
            <view class="info-row">
              <view class="info-icon-box">
                <image class="info-icon" src="{{item.icon}}" mode="aspectFit" />
              </view>
              <view class="info-label">{{item.label}}：</view>
              <view class="info-value {{item.highlight ? 'is-highlight' : ''}}">{{item.value}}</view>
            </view>
          </block>
        </view>

        <view class="comment-card">
          <view class="section-head">
            <view class="section-bar"></view>
            <view class="section-title">大家的评论</view>
          </view>

          <view class="state-block" wx:if="{{comments.length === 0}}">暂无评论</view>
          <block wx:else>
            <block wx:for="{{comments}}" wx:key="id">
              <view class="comment-item">
                <image class="comment-avatar" src="{{item.avatar}}" mode="aspectFill" />
                <view class="comment-body">
                  <view class="comment-top">
                    <view class="comment-name">{{item.nickname}}</view>
                    <view class="comment-time">{{item.time}}</view>
                  </view>
                  <view class="comment-text">{{item.content}}</view>
                </view>
              </view>
            </block>
          </block>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="comment-input-bar">
    <view class="comment-face-box">
      <image class="comment-face" src="/static/cat-detail/icon_comment_face.png" mode="aspectFit" />
    </view>
    <input
      class="comment-input"
      value="{{commentText}}"
      placeholder="说点什么..."
      placeholder-class="comment-placeholder"
      confirm-type="send"
      bindinput="onCommentInput"
      bindconfirm="onSendComment"
    />
    <view class="send-button" bindtap="onSendComment">发送</view>
  </view>
</view>
