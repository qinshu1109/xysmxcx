page {
  min-height: 100vh;
  background: #fff8f4;
}

.help-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff9f2 0%, #fff5f4 42%, #ffffff 100%);
  overflow: hidden;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: linear-gradient(180deg, #fffaf4 0%, rgba(255, 248, 244, 0.96) 100%);
}

.custom-nav__title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
}

.help-scroll {
  height: 100vh;
}

.help-content {
  width: 750rpx;
  min-height: 100vh;
  box-sizing: border-box;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.help-swiper {
  width: 686rpx;
  height: 250rpx;
  margin: 24rpx auto 0;
  overflow: hidden;
  border-radius: 28rpx;
}

.help-swiper-item,
.help-banner {
  width: 686rpx;
  height: 250rpx;
  border-radius: 28rpx;
  overflow: hidden;
}

.help-banner {
  display: block;
}

.search-box {
  display: flex;
  align-items: center;
  width: 686rpx;
  height: 74rpx;
  margin: 24rpx auto 0;
  padding: 0 26rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(155, 103, 82, 0.06);
}

.search-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.search-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 74rpx;
  color: #333333;
  font-size: 27rpx;
  line-height: 74rpx;
}

.search-placeholder {
  color: #aaa6a2;
}

.type-row {
  display: flex;
  align-items: center;
  width: 686rpx;
  margin: 22rpx auto 0;
  gap: 18rpx;
}

.type-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 58rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #ffffff;
  color: #333333;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 58rpx;
  box-shadow: 0 6rpx 18rpx rgba(82, 56, 44, 0.08);
  white-space: nowrap;
}

.type-pill.is-active {
  color: #ffffff;
  background: linear-gradient(135deg, #ff626d 0%, #ff7b73 100%);
  box-shadow: 0 10rpx 22rpx rgba(255, 97, 106, 0.22);
}

.status-row {
  display: flex;
  align-items: center;
  width: 686rpx;
  margin: 18rpx auto 0;
  overflow-x: auto;
  white-space: nowrap;
}

.status-filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  height: 48rpx;
  margin-right: 14rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #fff6f0;
  color: #8d8580;
  font-size: 23rpx;
  line-height: 48rpx;
}

.status-filter.is-active {
  color: #ff6b6f;
  font-weight: 700;
  background: #ffecef;
}

.post-list {
  width: 686rpx;
  margin: 22rpx auto 0;
}

.post-card {
  display: flex;
  align-items: flex-start;
  width: 686rpx;
  min-height: 196rpx;
  margin-bottom: 22rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(78, 52, 40, 0.08);
}

.post-thumb {
  display: block;
  flex: 0 0 154rpx;
  width: 154rpx;
  height: 154rpx;
  margin-right: 22rpx;
  border-radius: 22rpx;
  background: #f5f1ed;
}

.post-body {
  flex: 1;
  min-width: 0;
}

.post-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.post-title {
  display: block;
  flex: 1;
  min-width: 0;
  color: #111111;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.type-tag {
  display: block;
  flex: 0 0 auto;
  height: 40rpx;
  margin-left: 14rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.type-tag--help {
  color: #ff6b6f;
  background: #ffecef;
}

.type-tag--adoption {
  color: #ff8a13;
  background: #fff3de;
}

.post-desc {
  display: -webkit-box;
  margin-top: 10rpx;
  color: #777777;
  font-size: 24rpx;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.meta-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-right: 18rpx;
}

.meta-icon {
  display: block;
  flex: 0 0 26rpx;
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
}

.meta-text {
  display: block;
  max-width: 132rpx;
  color: #8b8785;
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.post-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.post-date {
  color: #aaa5a2;
  font-size: 22rpx;
  line-height: 30rpx;
}

.post-status {
  display: block;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 42rpx;
  white-space: nowrap;
}

.post-status--pending {
  color: #ff9619;
  background: #fff1d9;
}

.post-status--processing {
  color: #2f91ff;
  background: #e7f1ff;
}

.post-status--done {
  color: #35a85d;
  background: #e9f8e9;
}

.state-block {
  width: 686rpx;
  margin: 34rpx auto 0;
  padding: 56rpx 24rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: #ffffff;
  color: #8c8885;
  font-size: 27rpx;
  line-height: 38rpx;
  text-align: center;
  box-shadow: 0 12rpx 30rpx rgba(78, 52, 40, 0.07);
}

.help-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  height: calc(106rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.help-tab-item {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  height: 106rpx;
  box-sizing: border-box;
  padding-top: 10rpx;
  color: #4a4a4a;
}

.help-tab-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
}

.help-tab-icon {
  display: block;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
}

.help-tab-label {
  display: block;
  width: 100%;
  height: 30rpx;
  margin-top: 4rpx;
  color: inherit;
  font-size: 22rpx;
  line-height: 26rpx;
  text-align: center;
  white-space: nowrap;
  letter-spacing: 0;
}

.help-tab-item.is-active {
  color: #ff6b6f;
}
