page {
  min-height: 100vh;
  background: #fff8f5;
}

.help-detail-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ffc6cf 0%, #fff3f1 34%, #fff8f5 100%);
  overflow: hidden;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: linear-gradient(180deg, #ffc4ce 0%, rgba(255, 202, 210, 0.96) 100%);
}

.custom-nav__title {
  position: absolute;
  left: 0;
  right: 0;
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.custom-nav__back {
  position: absolute;
  left: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  z-index: 2;
}

.custom-nav__back-icon {
  display: block;
  width: 42rpx;
  height: 42rpx;
}

.detail-scroll {
  height: 100vh;
}

.detail-content {
  width: 750rpx;
  min-height: 100vh;
  box-sizing: border-box;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(138rpx + env(safe-area-inset-bottom));
}

.hero-photo {
  display: block;
  width: 686rpx;
  height: 300rpx;
  margin: 18rpx auto 0;
  border-radius: 26rpx;
  background: #f3ece6;
  overflow: hidden;
}

.summary-card,
.info-card,
.progress-card,
.comments-card {
  width: 686rpx;
  margin: 18rpx auto 0;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(148, 88, 72, 0.08);
}

.summary-card {
  display: flex;
  align-items: center;
  min-height: 136rpx;
  padding: 24rpx;
}

.summary-icon {
  display: block;
  flex: 0 0 84rpx;
  width: 84rpx;
  height: 84rpx;
  margin-right: 24rpx;
}

.summary-main {
  flex: 1;
  min-width: 0;
}

.summary-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.summary-title {
  display: block;
  flex: 1;
  min-width: 0;
  color: #111111;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 44rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.status-pill {
  display: block;
  flex: 0 0 auto;
  height: 48rpx;
  margin-left: 16rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 48rpx;
  white-space: nowrap;
}

.status-pill--pending {
  color: #ff9213;
  background: #fff1d8;
}

.summary-meta-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  min-width: 0;
}

.type-badge {
  display: block;
  flex: 0 0 auto;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  color: #ff6b6f;
  background: #ffe6e8;
  font-size: 22rpx;
  line-height: 36rpx;
  white-space: nowrap;
}

.publish-time {
  display: block;
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  color: #9c9895;
  font-size: 25rpx;
  line-height: 34rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.description-card {
  padding: 24rpx 28rpx 28rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
}

.section-accent {
  flex: 0 0 8rpx;
  width: 8rpx;
  height: 36rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff656f 0%, #ff9287 100%);
}

.section-title {
  display: block;
  color: #1f1f1f;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.description-text {
  margin-top: 14rpx;
  padding-left: 24rpx;
  color: #666666;
  font-size: 26rpx;
  line-height: 44rpx;
}

.contact-card {
  padding: 18rpx 28rpx;
}

.contact-row {
  display: flex;
  align-items: center;
  height: 62rpx;
}

.contact-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  margin-right: 18rpx;
}

.contact-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
}

.contact-label {
  display: block;
  flex: 0 0 auto;
  color: #222222;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 38rpx;
  white-space: nowrap;
}

.contact-value {
  display: block;
  flex: 1;
  min-width: 0;
  color: #666666;
  font-size: 27rpx;
  line-height: 38rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.progress-card {
  position: relative;
  height: 120rpx;
  padding: 16rpx 42rpx 18rpx;
  overflow: hidden;
}

.progress-line {
  position: absolute;
  left: 146rpx;
  top: 31rpx;
  display: block;
  width: 394rpx;
  height: 16rpx;
  z-index: 0;
}

.progress-items {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.progress-item {
  display: flex;
  flex: 0 0 150rpx;
  flex-direction: column;
  align-items: center;
}

.progress-dot {
  display: block;
  width: 46rpx;
  height: 46rpx;
}

.progress-label {
  display: block;
  width: 100%;
  margin-top: 10rpx;
  color: #777777;
  font-size: 25rpx;
  line-height: 34rpx;
  text-align: center;
  white-space: nowrap;
}

.progress-label.is-active {
  color: #ff6b6f;
  font-weight: 700;
}

.comments-card {
  padding: 22rpx 28rpx 12rpx;
}

.comments-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comments-more {
  display: block;
  flex: 0 0 auto;
  color: #8f8a87;
  font-size: 25rpx;
  line-height: 36rpx;
  white-space: nowrap;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(228, 216, 211, 0.7);
}

.comment-item:last-child {
  border-bottom: 0;
}

.comment-avatar {
  display: block;
  flex: 0 0 58rpx;
  width: 58rpx;
  height: 58rpx;
  margin-right: 20rpx;
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-top {
  display: flex;
  align-items: center;
  min-width: 0;
}

.comment-name {
  display: block;
  flex: 0 1 auto;
  max-width: 210rpx;
  color: #222222;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 34rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.comment-role {
  display: block;
  flex: 0 0 auto;
  height: 28rpx;
  margin-left: 10rpx;
  padding: 0 8rpx;
  border-radius: 7rpx;
  color: #ff6b6f;
  background: #ffe6e8;
  font-size: 19rpx;
  line-height: 28rpx;
  white-space: nowrap;
}

.comment-time {
  display: block;
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
  color: #aaa6a2;
  font-size: 23rpx;
  line-height: 32rpx;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.comment-content {
  display: block;
  margin-top: 4rpx;
  color: #555555;
  font-size: 25rpx;
  line-height: 36rpx;
}

.comment-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 50;
  display: flex;
  align-items: center;
  height: 74rpx;
  box-sizing: border-box;
  padding: 8rpx 8rpx 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 10rpx 28rpx rgba(126, 84, 72, 0.10);
}

.comment-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  margin-right: 14rpx;
}

.comment-icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
}

.comment-input {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  box-sizing: border-box;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #f4f1ef;
  color: #333333;
  font-size: 26rpx;
  line-height: 58rpx;
}

.comment-placeholder {
  color: #aaa6a2;
}

.send-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 116rpx;
  width: 116rpx;
  height: 58rpx;
  margin-left: 14rpx;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff626d 0%, #ff7f75 100%);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.send-button::after {
  border: 0;
}

.status-pill--processing {
  color: #2f91ff;
  background: #e7f1ff;
}

.status-pill--done {
  color: #3ba66b;
  background: #e4f7ed;
}

.state-block {
  padding: 44rpx 0;
  color: #9c9a9a;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: center;
}
