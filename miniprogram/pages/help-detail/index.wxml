<view class="help-detail-page">
  <view class="custom-nav" style="height: {{navHeight}}px;">
    <view
      class="custom-nav__back"
      style="top: {{navContentTop}}px; height: {{menuHeight}}px;"
      bindtap="onTapBack"
    >
      <image class="custom-nav__back-icon" src="/static/help-detail/icon_back_arrow.png" mode="aspectFit" />
    </view>
    <view
      class="custom-nav__title"
      style="top: {{navContentTop}}px; height: {{menuHeight}}px; line-height: {{menuHeight}}px;"
    >
      {{title}}
    </view>
  </view>

  <scroll-view class="detail-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="detail-content" style="padding-top: {{navHeight}}px;">
      <view class="state-block" wx:if="{{status === 'loading'}}">加载中</view>
      <view class="state-block" wx:elif="{{status === 'error'}}">{{errorMessage}}</view>

      <block wx:else>
        <image class="hero-photo" src="{{post.image}}" mode="aspectFill" />

        <view class="summary-card">
          <image class="summary-icon" src="{{post.icon}}" mode="aspectFit" />
          <view class="summary-main">
            <view class="summary-title-row">
              <view class="summary-title">{{post.title}}</view>
              <view class="status-pill status-pill--{{post.status}}">{{post.statusText}}</view>
            </view>
            <view class="summary-meta-row">
              <view class="type-badge">{{post.typeText}}</view>
              <view class="publish-time">{{post.publishTime}}</view>
            </view>
          </view>
        </view>

        <view class="info-card description-card">
          <view class="section-title-row">
            <view class="section-accent"></view>
            <view class="section-title">情况说明</view>
          </view>
          <view class="description-text">{{post.description}}</view>
        </view>

        <view class="info-card contact-card">
          <block wx:for="{{contactRows}}" wx:key="key">
            <view class="contact-row">
              <view class="contact-icon-box">
                <image class="contact-icon" src="{{item.icon}}" mode="aspectFit" />
              </view>
              <view class="contact-label">{{item.label}}：</view>
              <view class="contact-value">{{item.value}}</view>
            </view>
          </block>
        </view>

        <view class="progress-card">
          <image class="progress-line" src="/static/help-detail/help_detail_progress_line_asset.png" mode="scaleToFill" />
          <view class="progress-items">
            <block wx:for="{{progress}}" wx:key="label">
              <view class="progress-item">
                <image
                  class="progress-dot"
                  src="{{item.active ? '/static/help-detail/progress_step_active.png' : '/static/help-detail/progress_step_inactive.png'}}"
                  mode="aspectFit"
                />
                <view class="progress-label {{item.active ? 'is-active' : ''}}">{{item.label}}</view>
              </view>
            </block>
          </view>
        </view>

        <view class="comments-card">
          <view class="comments-header">
            <view class="section-title-row">
              <view class="section-accent"></view>
              <view class="section-title">志愿者留言</view>
            </view>
            <view class="comments-more">{{comments.length}}条留言 ＞</view>
          </view>

          <view class="state-block" wx:if="{{comments.length === 0}}">暂无留言</view>
          <block wx:else>
            <block wx:for="{{comments}}" wx:key="id">
              <view class="comment-item">
                <image class="comment-avatar" src="{{item.avatar}}" mode="aspectFit" />
                <view class="comment-body">
                  <view class="comment-top">
                    <view class="comment-name">{{item.nickname}}</view>
                    <view class="comment-role">{{item.role}}</view>
                    <view class="comment-time">{{item.time}}</view>
                  </view>
                  <view class="comment-content">{{item.content}}</view>
                </view>
              </view>
            </block>
          </block>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="comment-bar">
    <view class="comment-icon-box">
      <image class="comment-icon" src="/static/help-detail/icon_smile.png" mode="aspectFit" />
    </view>
    <input
      class="comment-input"
      value="{{commentText}}"
      placeholder="说点什么..."
      placeholder-class="comment-placeholder"
      confirm-type="send"
      bindinput="onCommentInput"
      bindconfirm="onSendComment"
    />
    <button class="send-button" bindtap="onSendComment">发送</button>
  </view>
</view>
