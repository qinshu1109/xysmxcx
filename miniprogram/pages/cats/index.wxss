page {
  min-height: 100vh;
  background: #fff8f4;
}

.cats-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff8f4 0%, #fff4ee 28%, #ffffff 78%);
  overflow: hidden;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: linear-gradient(180deg, #fffaf4 0%, rgba(255, 248, 244, 0.96) 100%);
}

.custom-nav__title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
}

.cats-scroll {
  height: 100vh;
}

.cats-content {
  width: 750rpx;
  min-height: 100vh;
  box-sizing: border-box;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.search-box {
  display: flex;
  align-items: center;
  width: 650rpx;
  height: 76rpx;
  margin: 42rpx auto 0;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 26rpx rgba(155, 103, 82, 0.06);
}

.search-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 42rpx;
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
}

.search-icon {
  display: block;
  width: 42rpx;
  height: 42rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  color: #333333;
  font-size: 28rpx;
  line-height: 76rpx;
}

.search-placeholder {
  color: #a8a4a2;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 686rpx;
  margin: 34rpx auto 0;
  padding: 24rpx 0 22rpx;
}

.filter-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 58rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #ffffff;
  color: #222222;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 58rpx;
  box-shadow: 0 6rpx 18rpx rgba(82, 56, 44, 0.08);
  white-space: nowrap;
}

.filter-pill.is-active {
  color: #ffffff;
  font-weight: 700;
  background: linear-gradient(135deg, #ff626d 0%, #ff7b73 100%);
  box-shadow: 0 10rpx 22rpx rgba(255, 97, 106, 0.22);
}

.cat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  column-gap: 22rpx;
  row-gap: 24rpx;
  width: 686rpx;
  margin: 0 auto;
}

.cat-card {
  min-width: 0;
  overflow: hidden;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(78, 52, 40, 0.08);
}

.cat-photo-wrap {
  position: relative;
  width: 100%;
  height: 176rpx;
  padding: 12rpx 12rpx 0;
  box-sizing: border-box;
}

.cat-photo {
  display: block;
  width: 100%;
  height: 164rpx;
  border-radius: 20rpx;
  background: #f5f1ed;
}

.gender-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: block;
  width: 56rpx;
  height: 56rpx;
}

.cat-info {
  padding: 20rpx 20rpx 22rpx;
}

.cat-name {
  display: block;
  color: #111111;
  font-size: 35rpx;
  font-weight: 800;
  line-height: 44rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cat-location-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin-top: 14rpx;
}

.cat-location {
  display: block;
  min-width: 0;
  color: #888888;
  font-size: 25rpx;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tag-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
  min-height: 42rpx;
}

.cat-tag {
  display: block;
  height: 42rpx;
  padding: 0 17rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 42rpx;
  white-space: nowrap;
}

.cat-tag--adoptable {
  color: #ff6570;
  background: #ffecef;
}

.cat-tag--neutered {
  color: #2d8dff;
  background: #eaf3ff;
}

.cat-tag--attention {
  color: #ff8a13;
  background: #fff3de;
}

.cat-tag--healthy {
  color: #35a85d;
  background: #e9f8e9;
}

.state-block {
  width: 686rpx;
  margin: 40rpx auto 0;
  padding: 56rpx 24rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: #ffffff;
  color: #8c8885;
  font-size: 27rpx;
  line-height: 38rpx;
  text-align: center;
  box-shadow: 0 12rpx 30rpx rgba(78, 52, 40, 0.07);
}

.cats-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  height: calc(106rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.cats-tab-item {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  height: 106rpx;
  box-sizing: border-box;
  padding-top: 10rpx;
  color: #4a4a4a;
}

.cats-tab-icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
}

.cats-tab-icon {
  display: block;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
}

.cats-tab-label {
  display: block;
  width: 100%;
  height: 30rpx;
  margin-top: 4rpx;
  color: inherit;
  font-size: 22rpx;
  line-height: 26rpx;
  text-align: center;
  white-space: nowrap;
  letter-spacing: 0;
}

.cats-tab-item.is-active {
  color: #ff6b6f;
}
