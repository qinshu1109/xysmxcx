page {
  min-height: 100vh;
  background: #fff8f4;
}

.home-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff9f2 0%, #fff7f7 44%, #ffffff 100%);
  overflow: hidden;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: linear-gradient(180deg, #fffaf3 0%, rgba(255, 248, 244, 0.96) 100%);
}

.custom-nav__title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  color: #111111;
  font-size: 34rpx;
  font-weight: 600;
}

.home-scroll {
  height: 100vh;
}

.home-content {
  width: 750rpx;
  min-height: 100vh;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.home-swiper {
  width: 686rpx;
  height: 402rpx;
  margin-top: 28rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 18rpx 38rpx rgba(255, 129, 103, 0.13);
}

.home-swiper-item,
.home-swiper-image {
  width: 686rpx;
  height: 402rpx;
  border-radius: 28rpx;
  overflow: hidden;
}

.home-swiper-image {
  display: block;
  flex-shrink: 0;
}

.home-middle-module {
  position: relative;
  width: 686rpx;
  height: 357rpx;
  margin: 24rpx auto 0;
  overflow: visible;
}

.home-middle-image {
  width: 686rpx;
  height: 357rpx;
  display: block;
}

.home-middle-hotspots {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  display: flex;
  width: 686rpx;
  height: 138rpx;
}

.home-middle-hotspot {
  flex: 1;
  height: 138rpx;
  background: transparent;
}

.help-card {
  width: 686rpx;
  margin-top: 28rpx;
  padding: 28rpx 28rpx 18rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 38rpx rgba(54, 38, 31, 0.08);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-head__left {
  display: flex;
  align-items: center;
}

.section-head__bar {
  width: 7rpx;
  height: 34rpx;
  margin-right: 18rpx;
  border-radius: 10rpx;
  background: #ff6b6f;
}

.section-head__title {
  color: #111111;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.section-head__more {
  color: #8a8583;
  font-size: 24rpx;
  line-height: 34rpx;
}

.help-item {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 148rpx;
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.help-item:last-child {
  margin-bottom: 0;
  border-bottom: 0;
}

.help-item__thumb {
  flex: 0 0 auto;
  width: 122rpx;
  height: 122rpx;
  border-radius: 20rpx;
}

.help-item__body {
  min-width: 0;
  padding-left: 24rpx;
  padding-right: 122rpx;
}

.help-item__title {
  color: #111111;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.help-item__desc {
  margin-top: 12rpx;
  color: #8b8887;
  font-size: 24rpx;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.help-item__date {
  margin-top: 8rpx;
  color: #9c9a9a;
  font-size: 23rpx;
  line-height: 32rpx;
}

.status-pill {
  position: absolute;
  right: 0;
  top: 58rpx;
  min-width: 86rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.status-pill--pending {
  color: #ff9619;
  background: #fff1d9;
}

.status-pill--processing {
  color: #2f91ff;
  background: #e7f1ff;
}
