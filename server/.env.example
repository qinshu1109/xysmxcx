# Copy this file to .env before starting on Windows.
# Keep .env local. Do not commit real database passwords or secrets.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=campus_cat_station
JWT_SECRET=change-this-local-user-secret
ADMIN_JWT_SECRET=change-this-local-admin-secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
UPLOAD_DIR=uploads
